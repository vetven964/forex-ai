PORT=10000
APP_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com
ALLOWED_ORIGINS=https://YOUR-RENDER-SERVICE.onrender.com
# Optional owner/admin fallback. End users can connect their own bot from the website Telegram Setup tab.
# Leave these blank if every user should provide their own Telegram Bot Token + Chat ID.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
RENDER=true
# VT Markets MT5 broker-native feed bridge
MT5_BRIDGE_API_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
MT5_SYMBOL=XAUUSD
MT5_MAX_AGE_MS=15000
# High-impact USD economic-news radar (server-side; no browser token)
NEWS_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
NEWS_CACHE_MS=60000
NEWS_PRE_MINUTES=120
NEWS_LOCK_BEFORE_MINUTES=30
NEWS_LOCK_AFTER_MINUTES=15
# Smart Entry Radar uses M5 as the execution timeframe by default.

# Telegram auto-alert policy: ENTRY_ONLY (default) or SETUP
TELEGRAM_AUTO_ALERT_LEVEL=ENTRY_ONLY
TELEGRAM_MIN_SCORE=65
