PORT=10000
APP_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com
ALLOWED_ORIGINS=https://YOUR-RENDER-SERVICE.onrender.com
# Optional owner/admin fallback. End users can connect their own bot from the website Telegram Setup tab.
# Leave these blank if every user should provide their own Telegram Bot Token + Chat ID.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
RENDER=true
# VT Markets MT5 broker-native feed bridge
MT5_BRIDGE_API_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
MT5_SYMBOL=XAUUSD
MT5_MAX_AGE_MS=15000
# Smart Entry Radar uses M5 as the execution timeframe by default.

# Telegram auto-alert policy: ENTRY_ONLY (default) or SETUP
TELEGRAM_AUTO_ALERT_LEVEL=ENTRY_ONLY
TELEGRAM_MIN_SCORE=76

# Optional persistent database. If omitted, v5.3.8 uses local JSONL storage.
DATABASE_URL=
TELEGRAM_NEWS_ALERTS=true
DATABASE_SSL=true
VTRADE_DATA_DIR=./data
STORAGE_RETENTION_DAYS=30
STORAGE_QUOTE_INTERVAL_MS=10000
NEWS_CACHE_MS=15000
NEWS_BRIDGE_MAX_AGE_MS=600000
# Optional comma-separated news calendar sources
NEWS_CALENDAR_URLS=https://nfs.faireconomy.media/ff_calendar_thisweek.json,https://cdn-nfs.faireconomy.media/ff_calendar_thisweek.json
NEWS_PRELOCK_MIN=15
NEWS_CAUTION_MIN=60
NEWS_LIVE_WINDOW_MIN=2
NEWS_POST_MIN=15

# OpenAI AI confirmation layer (server-side only; never expose the key in frontend code)
OPENAI_API_KEY=
OPENAI_ENABLED=true
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=9000
OPENAI_MIN_SCORE=76

# V7 Full Signal Engine
NEWS_FAIL_CLOSED=false
AI_DATA_QUALITY_MIN=75
MIN_CONFLUENCE=76
MIN_ENTRY_SCORE=76

# ============================================================
# V-TRADE AI v7.2 AUTO-TRADE (MT5 EA executes orders locally)
# Keep AUTO_TRADE_ENABLED=false until the EA + Demo/Cent account
# has been tested successfully.
# ============================================================
AUTO_TRADE_ENABLED=false
AUTO_TRADE_MIN_SCORE=76
AUTO_TRADE_LOT=0.01
AUTO_TRADE_MAX_LOT=0.02
AUTO_TRADE_MAX_OPEN=1
AUTO_TRADE_COOLDOWN_MS=300000
AUTO_TRADE_MAGIC=572007
# Profit amount is read in the MT5 account currency (e.g. USC on many cent accounts).
AUTO_TRADE_TRAIL_TRIGGER=2.00
AUTO_TRADE_LOCK_PROFIT=0.50
# MT5 points, not dollars. Adjust after checking XAUUSD broker digits.
AUTO_TRADE_TRAIL_DISTANCE_POINTS=100
AUTO_TRADE_SIGNAL_TTL_MS=15000
AUTO_TRADE_REQUIRE_MARKET=true
