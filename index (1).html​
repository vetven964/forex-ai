function switchAuthMode(mode) {
            authMode = mode;
            const loginBtn = document.getElementById('authTabLogin');
            const regBtn = document.getElementById('authTabRegister');
            const nameContainer = document.getElementById('nameFieldContainer');
            const submitBtn = document.getElementById('authSubmitBtn');

            if (mode === 'login') {
                loginBtn.className = "flex-1 py-2 rounded-md bg-blue-600 text-white transition";
                regBtn.className = "flex-1 py-2 rounded-md text-gray-400 hover:text-white transition";
                nameContainer.classList.add('hidden');
                submitBtn.innerText = "Sign In";
            } else {
                regBtn.className = "flex-1 py-2 rounded-md bg-blue-600 text-white transition";
                loginBtn.className = "flex-1 py-2 rounded-md text-gray-400 hover:text-white transition";
                nameContainer.classList.remove('hidden');
                submitBtn.innerText = "Register";
            }
        }

        function handleAuthSubmit() {
            const email = document.getElementById('authEmail').value.trim();
            if(!email) {
                alert("⚠️ សូមបំពេញអ៊ីមែលរបស់អ្នក!");
                return;
            }
            if(authMode === 'register') {
                const name = document.getElementById('regName').value.trim() || "User";
                localStorage.setItem('vet_user_name', name);
                document.getElementById('profileName').innerText = name;
                alert("✅ ចុះឈ្មោះជោគជ័យ!");
            }
            document.getElementById('authWrapper').style.display = 'none';
            document.getElementById('appWrapper').classList.remove('hidden');
            switchTab('landing');
            loadChart("BTCUSDT");
        }
